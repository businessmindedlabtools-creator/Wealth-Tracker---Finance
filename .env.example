# Copy to .env and fill in. Never commit .env.

# SQLite file, relative to prisma/ (or an absolute path on a persistent disk).
DATABASE_URL="file:./dev.db"

# Generate both values with: npm run auth:hash
AUTH_PASSWORD_HASH=""
AUTH_SECRET=""

# Only if serving the production build over plain HTTP on a trusted network.
# AUTH_INSECURE_COOKIE=1

# Backups (npm run db:backup). Point BACKUP_DIR at another disk or synced folder.
# BACKUP_DIR="./backups"
# BACKUP_KEEP=30
